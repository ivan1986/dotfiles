# Ghostty config (1.3) — mirrors ~/.config/kitty/kitty.conf
# Reload: ctrl+shift+, | Validate: ghostty +validate-config

# --- Fonts -------------------------------------------------------------------
font-family = JetBrainsMono Nerd Font
font-size = 12
adjust-cell-height = 10%
# Disable ligatures
font-feature = -calt
font-feature = -liga

# --- Theme -------------------------------------------------------------------
# List themes: ghostty +list-themes
theme = Catppuccin Mocha
background = #000000

# --- Cursor ------------------------------------------------------------------
cursor-style = bar
cursor-style-blink = false

# --- Scrollback (bytes) ------------------------------------------------------
scrollback-limit = 50000000

# --- Mouse / clipboard -------------------------------------------------------
copy-on-select = clipboard
mouse-hide-while-typing = true
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true

# --- Bell --------------------------------------------------------------------
bell-features = no-audio,attention,title,no-border

# --- Window ------------------------------------------------------------------
window-save-state = always
window-width = 120
window-height = 35
window-padding-x = 8
window-padding-y = 4
window-padding-balance = true
unfocused-split-opacity = 0.75
confirm-close-surface = true

# --- Tabs --------------------------------------------------------------------
gtk-tabs-location = bottom
window-show-tab-bar = auto

# --- Shell integration -------------------------------------------------------
# ssh-env/ssh-terminfo: push terminfo to remote hosts (like `kitten ssh`)
shell-integration = zsh
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo,path
notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s

# --- Keybindings -------------------------------------------------------------
# Splits: new pane in same cwd
keybind = ctrl+shift+enter=new_split:down
keybind = ctrl+shift+backslash=new_split:right
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+equal=equalize_splits

# Split navigation / resize
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right
keybind = alt+up=goto_split:up
keybind = alt+down=goto_split:down
keybind = ctrl+shift+left=resize_split:left,20
keybind = ctrl+shift+right=resize_split:right,20
keybind = ctrl+shift+up=resize_split:up,20
keybind = ctrl+shift+down=resize_split:down,20

# Tabs
keybind = ctrl+shift+t=new_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = shift+right=next_tab
keybind = shift+left=previous_tab
keybind = alt+one=goto_tab:1
keybind = alt+two=goto_tab:2
keybind = alt+three=goto_tab:3
keybind = alt+four=goto_tab:4
keybind = alt+five=goto_tab:5
keybind = alt+six=goto_tab:6
keybind = alt+seven=goto_tab:7
keybind = alt+eight=goto_tab:8
keybind = alt+nine=last_tab

# Font size
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# Scrollback
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
keybind = ctrl+shift+page_up=jump_to_prompt:-1
keybind = ctrl+shift+page_down=jump_to_prompt:1
keybind = ctrl+shift+h=write_scrollback_file:open
keybind = ctrl+shift+k=clear_screen
